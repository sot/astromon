# %ECSV 1.0
# ---
# delimiter: ','
# datatype:
# - {name: catalog, datatype: string, description: "astromon_cat_src.catalog of the excluded source. Empty for a
#     whole-observation exclusion."}
# - {name: name, datatype: string, description: "astromon_cat_src.name of the excluded source. Empty for a
#     whole-observation exclusion."}
# - {name: obsid, datatype: int32, description: "0 excludes the catalog source in every observation; a positive
#     obsid excludes that whole observation."}
# - {name: reason, datatype: string, description: Why it is excluded.}
# meta:
#   description: "The absolute-astrometry calibration's exclusions (astrometry repo, astrometry/match.py at d488bb1,
#     2026-11-04): EXCLUDED_CATALOG_SOURCES, the stars of EXCLUDED_TARGETS, and EXCLUDED_OBSIDS. Loaded into
#     astromon_regions by astromon.scripts.maintenance.load_exclusion_regions; offsets are the sky offset and
#     observation count from the calibration's roll test."
# schema: astropy-2.0
